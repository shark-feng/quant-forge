# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
.python-version

# ---- 测试与缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tmp_tests/
.tmp_diag/
.tmp_*/
# 草稿**文件**（如 .tmp_commitmsg.txt、.tmp_all.txt）：原先只忽略了同名目录，
# 导致 `git add -A` 会把草稿一起提交（M4-7 实测发生一次）
.tmp_*
.tmp/
.tox/
.nox/

# ---- 日志 ----
*.log
logs/

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 数据（体积大，不入库）----
data/raw/*
data/processed/*
data/index/*
data/fundamental/*
data/cache/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep
!data/fundamental/.gitkeep

# 列式缓存（体积大、可由原始数据重建）
*.parquet
*.feather
*.h5
*.hdf5

# ---- 回测输出（体积大，可复现）----
reports/*
!reports/.gitkeep
# 第三方框架交叉验证输出（Backtrader / PyBroker，见 docs/12_framework_matrix.md）
reports/bench/

# ---- AKShare 探测的 dry-run 产物（**假数据，绝不入库**；真实探测报告才提交）----
# 理由：dry-run 用 tests/fixtures/akshare/ 的手工构造样例，把它的结论当真实结论
# 会让「探测通过」变成假的通过（Q2 修正：靠目录与文件名区分，不靠报告里的 mode 字段）。
# 注意 `docs/data/probe_report.schema.json` 是规格文件，**必须**入库，故不在此忽略。
docs/data/dry-run/
*.dry-run.json
*.dry-run.md

# ---- 密钥与本地凭据（绝不入库）----
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# ---- 审计日志 ----
*.jsonl
!tests/fixtures/*.jsonl

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地笔记 ----
*.local.md
*.local.yaml
scratch/